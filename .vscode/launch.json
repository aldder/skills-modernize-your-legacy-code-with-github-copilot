{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Account Management System",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/src/accounting/index.js",
            "restart": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src/accounting",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Account Management System (Debug)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/src/accounting/index.js",
            "restart": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src/accounting",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outputCapture": "std"
        }
    ]
}